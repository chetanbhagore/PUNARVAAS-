# PUNARVAAS Frontend Environment Variables
# =========================================
# Copy this file to .env.local for local development
# Set these in Vercel Dashboard for production deployment

# Backend API Base URL
# - Local dev: leave empty (Vite proxy handles /api → localhost:8000)
# - Vercel production: set to your Render/Railway backend URL
VITE_API_BASE=https://YOUR-BACKEND-NAME.onrender.com/api
